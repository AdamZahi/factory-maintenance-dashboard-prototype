generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERUSER
  ADMIN
  TECHNICIAN
}

model User {
  id              String                @id
  email           String                @unique
  name            String
  position        String? // job title, e.g. "Coordinateur", "Responsable maintenance"
  role            Role                  @default(TECHNICIAN)
  isActive        Boolean               @default(true) // soft-delete flag
  createdAt       DateTime              @default(now())
  assignments     EquipmentAssignment[]
  inspections     Inspection[]
  notifications   Notification[]
  maintenanceLogs MaintenanceLog[]
}

model Equipment {
  id              String                @id
  name            String
  assignments     EquipmentAssignment[]
  readings        EquipmentReading[]
  notifications   Notification[]
  schedule        MaintenanceSchedule?
  maintenanceLogs MaintenanceLog[]
}

// Periodic servicing schedule per hour-tracked equipment (separate from the
// status-alert Notification system). One row per tracked equipment.
model MaintenanceSchedule {
  id                      String    @id @default(cuid())
  equipment               Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId             String    @unique
  intervalHours           Int? // null if not hour-tracked
  intervalDays            Int? // null unless equipment has a calendar rule (groupe_electrogene: 365)
  warningHoursBefore      Int
  warningDaysBefore       Int? // advance window for the calendar deadline (groupe_electrogene: 14)
  lastServiceMeterReading Float     @default(0)
  lastServiceDate         DateTime  @default(now())
  hourReminderSent        Boolean   @default(false)
  dayReminderSent         Boolean   @default(false)
  updatedAt               DateTime  @updatedAt
}

// Audit trail of servicing events (who reset the counter, at what meter reading).
model MaintenanceLog {
  id                    String    @id @default(cuid())
  equipment             Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId           String
  performedBy           User      @relation(fields: [performedById], references: [id])
  performedById         String
  meterReadingAtService Float
  serviceDate           DateTime  @default(now())
  createdAt             DateTime  @default(now())

  @@index([equipmentId, serviceDate])
}

model Notification {
  id           String    @id @default(cuid())
  recipient    User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  inspectionId String
  status       String // "warning" | "critical" — the status that triggered it
  message      String
  emailSent    Boolean   @default(false)
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model EquipmentAssignment {
  id           String    @id @default(cuid())
  technician   User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  technicianId String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  assignedBy   String
  assignedAt   DateTime  @default(now())

  @@unique([technicianId, equipmentId])
  @@index([technicianId])
  @@index([equipmentId])
}

model Inspection {
  id            String            @id @default(cuid())
  date          DateTime
  technician    User              @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  technicianId  String
  overallStatus String
  createdAt     DateTime          @default(now())
  readings      EquipmentReading[]

  @@index([technicianId])
  @@index([date])
}

model EquipmentReading {
  id           String     @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  equipment    Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  status       String
  fields       Json

  @@index([inspectionId])
  @@index([equipmentId])
}
